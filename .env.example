# --- API server (server/) ---
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0&compressors=zlib
#         (URL-encode special characters in the password)
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=pulse_clinic
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed front-end origins
CLIENT_ORIGIN=http://localhost:5173,https://pulseclinicpr.netlify.app

# --- Front-end (Vite) ---
# Leave unset in development (Vite proxies /api to the server above).
# For the Netlify build set it to the public API URL, e.g. https://pulse-api.onrender.com/api
# VITE_API_URL=
